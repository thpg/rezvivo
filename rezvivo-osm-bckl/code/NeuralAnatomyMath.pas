unit NeuralAnatomyMath;
{$mode objfpc}{$H+}{$INLINE ON}
interface
uses SysUtils, Math;
type
  TVec3 = record X,Y,Z: Double; end;
  TMat3 = array[0..2,0..2] of Double;
  TVecArray = array of TVec3;
  TBoolVector = array of Boolean;
{ Keep the scalar expression order: inline removes call/record temporaries
  from field and meshing loops without enabling reassociation or fast math. }
function V(const X,Y,Z: Double): TVec3; inline;
function Add(const A,B: TVec3): TVec3; inline;
function Sub(const A,B: TVec3): TVec3; inline;
function Scale(const A: TVec3; const S: Double): TVec3; inline;
function Dot(const A,B: TVec3): Double; inline;
function Cross(const A,B: TVec3): TVec3; inline;
function TetDeterminant(const A,B,C,D:TVec3):Double;inline;
function Norm(const A: TVec3): Double; inline;
function UnitVec(const A: TVec3): TVec3;
function Lerp(const A,B: TVec3; const T: Double): TVec3; inline;
function Identity: TMat3;
function Columns(const A,B,C: TVec3): TMat3;
function MV(const A: TMat3; const B: TVec3): TVec3; inline;
function MM(const A,B: TMat3): TMat3;
function Transpose(const A: TMat3): TMat3;
function Det(const A: TMat3): Double;
function Inverse(const A: TMat3): TMat3;
function MAdd(const A,B: TMat3): TMat3;
function MScale(const A: TMat3; const S: Double): TMat3;
function Outer(const A,B: TVec3): TMat3;
function Inner(const A,B: TMat3): Double;
function Component(const A: TVec3; const I: Integer): Double;
function Finite(const X: Double): Boolean;
procedure Require(const Condition: Boolean; const Msg: string);
implementation
function V(const X,Y,Z: Double): TVec3; inline;
begin Result.X:=X; Result.Y:=Y; Result.Z:=Z end;
function Add(const A,B: TVec3): TVec3; inline;
begin Result:=V(A.X+B.X,A.Y+B.Y,A.Z+B.Z) end;
function Sub(const A,B: TVec3): TVec3; inline;
begin Result:=V(A.X-B.X,A.Y-B.Y,A.Z-B.Z) end;
function Scale(const A: TVec3; const S: Double): TVec3; inline;
begin Result:=V(A.X*S,A.Y*S,A.Z*S) end;
function Dot(const A,B: TVec3): Double; inline;
begin Result:=A.X*B.X+A.Y*B.Y+A.Z*B.Z end;
function Cross(const A,B: TVec3): TVec3; inline;
begin Result:=V(A.Y*B.Z-A.Z*B.Y,A.Z*B.X-A.X*B.Z,A.X*B.Y-A.Y*B.X) end;
function TetDeterminant(const A,B,C,D:TVec3):Double;inline;
begin Result:=Dot(Sub(B,A),Cross(Sub(C,A),Sub(D,A)))end;
function Norm(const A: TVec3): Double; inline;
begin Result:=Sqrt(Dot(A,A)) end;
function UnitVec(const A: TVec3): TVec3;
var N: Double;
begin N:=Norm(A); Require(N>1e-15,'Zero direction'); Result:=Scale(A,1/N) end;
function Lerp(const A,B: TVec3; const T: Double): TVec3; inline;
begin Result:=Add(Scale(A,1-T),Scale(B,T)) end;
function Identity: TMat3;
var I: Integer;
begin FillChar(Result,SizeOf(Result),0); for I:=0 to 2 do Result[I,I]:=1 end;
function Columns(const A,B,C: TVec3): TMat3;
var I: Integer;
begin for I:=0 to 2 do begin Result[I,0]:=Component(A,I); Result[I,1]:=Component(B,I); Result[I,2]:=Component(C,I) end end;
function MV(const A: TMat3; const B: TVec3): TVec3; inline;
begin Result:=V(A[0,0]*B.X+A[0,1]*B.Y+A[0,2]*B.Z,A[1,0]*B.X+A[1,1]*B.Y+A[1,2]*B.Z,A[2,0]*B.X+A[2,1]*B.Y+A[2,2]*B.Z) end;
function MM(const A,B: TMat3): TMat3;
var I,J,K: Integer;
begin FillChar(Result,SizeOf(Result),0); for I:=0 to 2 do for J:=0 to 2 do for K:=0 to 2 do Result[I,J]:=Result[I,J]+A[I,K]*B[K,J] end;
function Transpose(const A: TMat3): TMat3;
var I,J: Integer;
begin for I:=0 to 2 do for J:=0 to 2 do Result[I,J]:=A[J,I] end;
function Det(const A: TMat3): Double;
begin Result:=A[0,0]*(A[1,1]*A[2,2]-A[1,2]*A[2,1])-A[0,1]*(A[1,0]*A[2,2]-A[1,2]*A[2,0])+A[0,2]*(A[1,0]*A[2,1]-A[1,1]*A[2,0]) end;
function Inverse(const A: TMat3): TMat3;
var D: Double;
begin
 D:=Det(A); Require(Finite(D) and (Abs(D)>1e-30),'Singular matrix');
 Result[0,0]:=(A[1,1]*A[2,2]-A[1,2]*A[2,1])/D;
 Result[0,1]:=(A[0,2]*A[2,1]-A[0,1]*A[2,2])/D;
 Result[0,2]:=(A[0,1]*A[1,2]-A[0,2]*A[1,1])/D;
 Result[1,0]:=(A[1,2]*A[2,0]-A[1,0]*A[2,2])/D;
 Result[1,1]:=(A[0,0]*A[2,2]-A[0,2]*A[2,0])/D;
 Result[1,2]:=(A[0,2]*A[1,0]-A[0,0]*A[1,2])/D;
 Result[2,0]:=(A[1,0]*A[2,1]-A[1,1]*A[2,0])/D;
 Result[2,1]:=(A[0,1]*A[2,0]-A[0,0]*A[2,1])/D;
 Result[2,2]:=(A[0,0]*A[1,1]-A[0,1]*A[1,0])/D;
end;
function MAdd(const A,B: TMat3): TMat3;
var I,J: Integer;
begin for I:=0 to 2 do for J:=0 to 2 do Result[I,J]:=A[I,J]+B[I,J] end;
function MScale(const A: TMat3; const S: Double): TMat3;
var I,J: Integer;
begin for I:=0 to 2 do for J:=0 to 2 do Result[I,J]:=A[I,J]*S end;
function Outer(const A,B: TVec3): TMat3;
var I,J: Integer;
begin for I:=0 to 2 do for J:=0 to 2 do Result[I,J]:=Component(A,I)*Component(B,J) end;
function Inner(const A,B: TMat3): Double;
var I,J: Integer;
begin Result:=0; for I:=0 to 2 do for J:=0 to 2 do Result:=Result+A[I,J]*B[I,J] end;
function Component(const A: TVec3; const I: Integer): Double;
begin case I of 0:Result:=A.X; 1:Result:=A.Y; 2:Result:=A.Z; else raise Exception.Create('Vector index') end end;
function Finite(const X: Double): Boolean;
begin Result:=not(IsNan(X) or IsInfinite(X)) end;
procedure Require(const Condition: Boolean; const Msg: string);
begin if not Condition then raise Exception.Create(Msg) end;
end.
