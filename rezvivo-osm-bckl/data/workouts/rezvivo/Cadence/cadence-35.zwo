<?xml version='1.0' encoding='utf-8'?>
<workout_file>
  <author>REZVIVO</author>
  <name>Cadence changes · 35 min</name>
  <description>5 min warm-up, 5 × (3 min at 70% and 95 rpm / 2 min at 55% and 80 rpm), 5 min cool-down.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.7" />
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="120" OnPower="0.7" OffPower="0.55" Cadence="95" CadenceResting="80" />
    <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4" />
  </workout>
</workout_file>