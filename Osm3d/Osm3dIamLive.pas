var
  GIamLiveCounters: array[0..1832] of Int64;

procedure IamLiveTrack(AIdx: Integer); inline;
begin
  Inc(GIamLiveCounters[AIdx]);
end;

{$IFDEF IAM_LIVE}
function CompareCountDesc(List: TStringList;
                          Index1, Index2: Integer): Integer;
var
  P1, P2: Integer;
  C1, C2: Int64;
begin
  P1 := Pos(#9, List[Index1]);
  P2 := Pos(#9, List[Index2]);
  C1 := StrToInt64Def(Copy(List[Index1], P1 + 1, MaxInt), 0);
  C2 := StrToInt64Def(Copy(List[Index2], P2 + 1, MaxInt), 0);
  if C1 > C2 then Result := -1
  else if C1 < C2 then Result :=  1
  else Result := 0;
end;

procedure SaveIamLive;
var
  OutPath : string;
  SL      : TStringList;
  I       : Integer;
begin
  OutPath := IncludeTrailingPathDelimiter(
               ExtractFilePath(ParamStr(0))) + 'iamlive.txt';
  SL := TStringList.Create;
  try
    for I := 0 to IAM_LIVE_COUNT - 1 do
      if GIamLiveCounters[I] > 0 then
        SL.Add(IAM_LIVE_NAMES[I] + #9 + IntToStr(GIamLiveCounters[I]));
    SL.CustomSort(@CompareCountDesc);
    SL.SaveToFile(OutPath);
  finally
    SL.Free;
  end;
end;
{$ENDIF IAM_LIVE}

finalization
{$IFDEF IAM_LIVE}
  try
    SaveIamLive;
  except
  end;
{$ENDIF IAM_LIVE}

end.
