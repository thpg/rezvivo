<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="osm3d_studio_gui"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="castle_engine_window"/>
      </Item>
      <Item>
        <PackageName Value="castle_engine_lcl"/>
      </Item>
      <Item>
        <PackageName Value="castle_engine_base"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="osm3d_studio_gui.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\rezvivo-osm-bckl\code\PBRTextureUnit.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="osm3d_studio_gui"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\rezvivo-osm-bckl\code;..\Mcp;..\tree-editor\core;..\tree-editor\render"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
    </Other>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
        <Enabled Value="False"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
        <Enabled Value="False"/>
      </Item>
      <Item>
        <Name Value="EHTTPClient"/>
        <Enabled Value="False"/>
      </Item>
      <Item>
        <Name Value="EArgumentOutOfRangeException"/>
        <Enabled Value="False"/>
      </Item>
      <Item>
        <Name Value="ESocketError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
