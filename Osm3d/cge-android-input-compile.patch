+procedure AndroidCollectPendingInput;
+begin
+  if (GetCurrentThreadID <> MainThreadID) or (AndroidMainApp = nil) then Exit;
+  if AndroidMainApp^.inputQueue = nil then Exit;
+  if AInputQueue_hasEvents(AndroidMainApp^.inputQueue) > 0 then
+    process_input(AndroidMainApp, @AndroidMainApp^.inputPollSource);
+end;
