diff --git a/src/base_rendering/castleinternalandroidshaderjobs.pas b/src/base_rendering/castleinternalandroidshaderjobs.pas
new file mode 100644
--- /dev/null
+++ b/src/base_rendering/castleinternalandroidshaderjobs.pas
@@ -0,0 +1,237 @@
+{ Android shader preparation in a shared EGL context. The native app thread
+  acknowledges input/lifecycle while the driver compiles, without reentering
+  scene loading, rendering, or UI callbacks. Shader/program objects are shared;
+  the worker never sees a scene, X3D field, renderer state cache, or UI object. }
+unit CastleInternalAndroidShaderJobs;
+{$I castleconf.inc}
+interface
+uses SysUtils, CastleGLES;
+type
+  TAndroidShaderOperation = (asoCompile, asoLink, asoLoadBinary, asoSaveBinary);
+  TAndroidShaderProgress = procedure(const Stage, Name: String;
+    const ElapsedMs: QWord; const Finished: Boolean);
+var
+  AndroidShaderProgress: TAndroidShaderProgress;
+{ False means no shared context is available; caller retains the normal GL
+  fallback. A failed shader itself returns True with Status = GL_FALSE. }
+function AndroidShaderJob(const Operation: TAndroidShaderOperation;
+  const Id: GLuint; var Status: GLint; var Format: GLenum; var Data: TBytes;
+  const Name: String): Boolean;
+function AndroidCompileShader(const Id: GLuint; out Status: GLint;
+  const Name: String): Boolean;
+function AndroidLinkProgram(const Id: GLuint; out Status: GLint;
+  const Name: String): Boolean;
+implementation
+uses Classes, SyncObjs, CastleInternalEgl, CastleAndroidNativeAppGlue,
+  CastleApplicationProperties, CastleLog;
+type
+  TShaderWorker = class(TThread)
+  public
+    Display: EGLDisplay;
+    ParentContext, Context: EGLContext;
+    Surface: EGLSurface;
+    ConfigId, ClientVersion: EGLint;
+    Ready, Request, Completed: TEvent;
+    Available: Boolean;
+    ErrorText: String;
+    Operation: TAndroidShaderOperation;
+    ObjectId: GLuint;
+    Status: GLint;
+    Format: GLenum;
+    Data: TBytes;
+    constructor Create;
+    destructor Destroy; override;
+    procedure Execute; override;
+  end;
+  TShaderJobs = class
+    Worker: TShaderWorker;
+    constructor Create;
+    destructor Destroy; override;
+    procedure ContextClose(Sender: TObject);
+  end;
+var Jobs: TShaderJobs;
+
+constructor TShaderWorker.Create;
+begin
+  inherited Create(True);
+  FreeOnTerminate := False;
+  Ready := TEvent.Create(nil, True, False, '');
+  Request := TEvent.Create(nil, False, False, '');
+  Completed := TEvent.Create(nil, True, False, '');
+  Display := eglGetCurrentDisplay();
+  ParentContext := eglGetCurrentContext();
+  eglQueryContext(Display, ParentContext, EGL_CONFIG_ID, @ConfigId);
+  eglQueryContext(Display, ParentContext, EGL_CONTEXT_CLIENT_VERSION, @ClientVersion);
+  Start;
+end;
+
+destructor TShaderWorker.Destroy;
+begin
+  Terminate;
+  Request.SetEvent;
+  WaitFor;
+  Ready.Free; Request.Free; Completed.Free;
+  inherited;
+end;
+
+procedure TShaderWorker.Execute;
+var Config: EGLConfig; Count, Actual: EGLint;
+  ConfigAttrs: array[0..2] of EGLint;
+  ContextAttrs: array[0..2] of EGLint;
+  SurfaceAttrs: array[0..4] of EGLint;
+  Size, ErrorCount: GLint;
+  {$ifdef REZVIVO_ANDROID_SHADER_JOB_TEST}
+  DelayFile: String; DelayText: TStringList; DelayMs: Integer;
+  {$endif}
+begin
+  try
+    try
+      ConfigAttrs[0] := EGL_CONFIG_ID; ConfigAttrs[1] := ConfigId; ConfigAttrs[2] := EGL_NONE;
+      ContextAttrs[0] := EGL_CONTEXT_CLIENT_VERSION; ContextAttrs[1] := ClientVersion; ContextAttrs[2] := EGL_NONE;
+      SurfaceAttrs[0] := EGL_WIDTH; SurfaceAttrs[1] := 1;
+      SurfaceAttrs[2] := EGL_HEIGHT; SurfaceAttrs[3] := 1; SurfaceAttrs[4] := EGL_NONE;
+      Count := 0;
+      if (Display = EGL_NO_DISPLAY) or (ParentContext = EGL_NO_CONTEXT) or
+         (eglChooseConfig(Display, @ConfigAttrs[0], @Config, 1, @Count) = EGL_FALSE) or
+         (Count = 0) then raise Exception.Create('No matching EGL configuration');
+      Context := eglCreateContext(Display, Config, ParentContext, @ContextAttrs[0]);
+      if Context = EGL_NO_CONTEXT then raise Exception.Create('Cannot share EGL context');
+      Surface := eglCreatePbufferSurface(Display, Config, @SurfaceAttrs[0]);
+      if Surface = EGL_NO_SURFACE then raise Exception.Create('Cannot create EGL pbuffer');
+      Available := eglMakeCurrent(Display, Surface, Surface, Context) <> EGL_FALSE;
+    except on E: Exception do ErrorText := E.ClassName + ': ' + E.Message end;
+  finally Ready.SetEvent end;
+  try
+    if not Available then Exit;
+    while not Terminated do
+    begin
+      Request.WaitFor(INFINITE);
+      if Terminated then Break;
+      try
+        ErrorText := '';
+        {$ifdef REZVIVO_ANDROID_SHADER_JOB_TEST}
+        { Fault injection is absent from production builds. Private test file
+          is consumed once, allowing a >5 s driver delay on a fast test GPU. }
+        DelayFile := IncludeTrailingPathDelimiter(String(AndroidMainApp^.Activity^.InternalDataPath)) + 'shader-job-test-delay';
+        if FileExists(DelayFile) then
+        begin
+          DelayText := TStringList.Create;
+          try DelayText.LoadFromFile(DelayFile); DelayMs := StrToIntDef(Trim(DelayText.Text), 0);
+          finally DelayText.Free end;
+          DeleteFile(DelayFile);
+          if (DelayMs > 0) and (DelayMs <= 60000) then Sleep(DelayMs);
+        end;
+        {$endif}
+        case Operation of
+          asoCompile: begin glCompileShader(ObjectId); glGetShaderiv(ObjectId, GL_COMPILE_STATUS, @Status) end;
+          asoLink: begin glLinkProgram(ObjectId); glGetProgramiv(ObjectId, GL_LINK_STATUS, @Status) end;
+          asoLoadBinary:
+            begin
+              glProgramBinary(ObjectId, Format, @Data[0], Length(Data));
+              glGetProgramiv(ObjectId, GL_LINK_STATUS, @Status);
+              { An invalid cache is an expected miss, never a later GL error. }
+              for ErrorCount := 1 to 4 do if glGetError() = GL_NO_ERROR then Break;
+            end;
+          asoSaveBinary:
+            begin
+              glGetProgramiv(ObjectId, GL_PROGRAM_BINARY_LENGTH, @Size);
+              Data := nil; Status := GL_FALSE;
+              if (Size > 0) and (Size <= 32 * 1024 * 1024) then
+              begin
+                SetLength(Data, Size);
+                glGetProgramBinary(ObjectId, Size, @Actual, @Format, @Data[0]);
+                if (Actual > 0) and (Actual <= Size) then
+                begin SetLength(Data, Actual); Status := GL_TRUE end else Data := nil;
+              end;
+            end;
+        end;
+        { Publish completed objects to the rendering context before signaling.
+          This context has no scene draws, so it cannot wait for a whole frame. }
+        glFinish;
+      except on E: Exception do ErrorText := E.ClassName + ': ' + E.Message end;
+      Completed.SetEvent;
+    end;
+  finally
+    if Available then eglMakeCurrent(Display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if Surface <> EGL_NO_SURFACE then eglDestroySurface(Display, Surface);
+    if Context <> EGL_NO_CONTEXT then eglDestroyContext(Display, Context);
+    Surface := EGL_NO_SURFACE; Context := EGL_NO_CONTEXT;
+  end;
+end;
+
+constructor TShaderJobs.Create;
+begin
+  inherited;
+  ApplicationProperties.OnGLContextCloseObject.Add(@ContextClose);
+end;
+destructor TShaderJobs.Destroy;
+begin
+  ApplicationProperties.OnGLContextCloseObject.Remove(@ContextClose);
+  ContextClose(nil);
+  inherited;
+end;
+procedure TShaderJobs.ContextClose(Sender: TObject);
+begin FreeAndNil(Worker) end;
+
+function AndroidShaderJob(const Operation: TAndroidShaderOperation;
+  const Id: GLuint; var Status: GLint; var Format: GLenum; var Data: TBytes;
+  const Name: String): Boolean;
+const Stages: array[TAndroidShaderOperation] of String = ('compile', 'link', 'cache', 'save');
+var W: TShaderWorker; Started, LastProgress, NowTick: QWord;
+
+  procedure CollectInputAndProgress;
+  begin
+    AndroidCollectPendingInput;
+    NowTick := GetTickCount64;
+    if Assigned(AndroidShaderProgress) and (NowTick - LastProgress >= 250) then
+    begin
+      AndroidShaderProgress(Stages[Operation], Name, NowTick - Started, False);
+      LastProgress := NowTick;
+    end;
+  end;
+
+begin
+  Result := False;
+  if (GetCurrentThreadID <> MainThreadID) or (eglGetCurrentContext() = EGL_NO_CONTEXT) then Exit;
+  if GetEnvironmentVariable('REZVIVO_ANDROID_SHADER_WORKER') = '0' then Exit;
+  if Jobs = nil then Jobs := TShaderJobs.Create;
+  Started := GetTickCount64; LastProgress := Started;
+  AndroidBeginResourceWait;
+  try
+    if Assigned(AndroidShaderProgress) then AndroidShaderProgress(Stages[Operation], Name, 0, False);
+    if Jobs.Worker = nil then
+    begin
+      Jobs.Worker := TShaderWorker.Create;
+      while Jobs.Worker.Ready.WaitFor(8) = wrTimeout do CollectInputAndProgress;
+      WritelnLog('AndroidShaders', 'shared_context=%s detail="%s"',
+        [BoolToStr(Jobs.Worker.Available, True), Jobs.Worker.ErrorText]);
+    end;
+    W := Jobs.Worker;
+    if not W.Available then Exit;
+    Assert(W.ParentContext = eglGetCurrentContext());
+    W.Operation := Operation; W.ObjectId := Id; W.Format := Format;
+    W.Data := Data; W.Status := GL_FALSE; W.Completed.ResetEvent;
+    glFlush; { make the newly created/attached shader objects visible }
+    W.Request.SetEvent;
+    while W.Completed.WaitFor(8) = wrTimeout do
+      CollectInputAndProgress;
+    if W.ErrorText <> '' then raise Exception.Create('Android shader worker: ' + W.ErrorText);
+    Status := W.Status; Format := W.Format; Data := W.Data; W.Data := nil;
+    Result := True;
+  finally
+    AndroidCollectPendingInput;
+    AndroidEndResourceWait;
+    if Assigned(AndroidShaderProgress) then AndroidShaderProgress(Stages[Operation], Name, GetTickCount64 - Started, True);
+  end;
+end;
+
+function AndroidCompileShader(const Id: GLuint; out Status: GLint; const Name: String): Boolean;
+var Format: GLenum; Data: TBytes;
+begin Format := 0; Data := nil; Result := AndroidShaderJob(asoCompile, Id, Status, Format, Data, Name) end;
+function AndroidLinkProgram(const Id: GLuint; out Status: GLint; const Name: String): Boolean;
+var Format: GLenum; Data: TBytes;
+begin Format := 0; Data := nil; Result := AndroidShaderJob(asoLink, Id, Status, Format, Data, Name) end;
+
+finalization
+  FreeAndNil(Jobs);
+end.
