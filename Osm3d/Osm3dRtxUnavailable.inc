  const Position:TVector3;Renderer,Shared:TTreeRenderer;Season:Single):Boolean;
begin Result:=False end;
function TRtxShadow.TimeAvailable:Boolean;
begin Result:=False end;
function TRtxShadow.Trace(const Zones:TRtxZones):Boolean;
begin Result:=False end;
