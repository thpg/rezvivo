    '    item = sub.add_parser(''format'', help=''choose runtime writes; takes effect on next map load'')'#10 +
    '    item.add_argument(''value'', choices=[''binary'', ''x3d''])'#10 +
    '    item.add_argument(''--root'', type=Path, default=Path(__file__).resolve().parent)'#10 +
    '    args = parser.parse_args()'#10 +
    '    if args.command == ''format'':'#10 +
    '        args.root.mkdir(parents=True, exist_ok=True)'#10 +
    '        path = args.root / ''tile-cache-format.cfg'''#10 +
