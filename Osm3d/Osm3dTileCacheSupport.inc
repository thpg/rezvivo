    ''#10 +
    ''#10 +
    'def limited(value, limit):'#10 +
    '    if isinstance(value, dict):'#10 +
    '        return {k: (v if k == ''fields'' else limited(v, limit)) for k, v in value.items()}'#10 +
    '    if isinstance(value, (array, list, tuple)):'#10 +
    '        if limit and len(value) > limit:'#10 +
