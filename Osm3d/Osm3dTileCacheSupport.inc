    '        uv = p.scalars(''f'', vc * 2)'#10 +
    '        indices = p.scalars(''I'', ic)'#10 +
    '        materials = p.scalars(''i'', mc)'#10 +
    '        water = p.scalars(''f'', wc)'#10 +
    '        osm = p.scalars(''q'', oc)'#10 +
    '        border = p.scalars(''I'', bc)'#10 +
    '        require(all(i < pc for i in pool), ''pool index out of range'')'#10 +
    '        require(all(i < vc for i in indices) and all(i < vc for i in border), ''vertex index out of range'')'#10 +
    '        result = dict(name=name, material=material, solid=bool(flags & 1),'#10 +
    '                      vertex_count=vc, pool_count=pc, triangles=ic // 3,'#10 +
    '                      position_normal=pn, pool_indices=pool, uv=uv, indices=indices,'#10 +
    '                      material_ids=materials, water_scale=water, osm_ids=osm, border_indices=border)'#10 +
    '    elif kind == ''TREE'':'#10 +
    '        records = p.records(TREE, p.u32())'#10 +
    '        finite_records(records)'#10 +
    '        require(all(r[6] <= 1 for r in records), ''invalid tree flags'')'#10 +
    '        result = dict(fields=TREE_FIELDS, records=records)'#10 +
    '    elif kind == ''POIS'':'#10 +
    '        names = p.strings()'#10 +
    '        records = p.records(POI, p.u32())'#10 +
    '        finite_records(records)'#10 +
    '        require(all(r[0] < len(names) for r in records), ''POI kind index'')'#10 +
    '        result = dict(kinds=names, fields=[''kind_index'', ''x'', ''y'', ''z'', ''rotation''], records=records)'#10 +
    '    elif kind == ''ROAD'':'#10 +
    '        n, np, nl = p.values(''3I'')'#10 +
    '        records = p.records(ROAD, n)'#10 +
    '        points = p.scalars(''f'', np * 2)'#10 +
    '        widths = p.scalars(''f'', nl)'#10 +
    '        finite_records(records)'#10 +
    '        require(all(r[0] < np and r[1] < np and r[4] <= 1 and'#10 +
    '                    r[17] <= 32 and r[16] + r[17] <= nl for r in records), ''invalid road offsets'')'#10 +
