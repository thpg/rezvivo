    ''#10 +
    'class Tile:'#10 +
    '    def __init__(self, path):'#10 +
    '        self.path = Path(path)'#10 +
    '        self.entries = []'#10 +
    '        with self.path.open(''rb'') as f:'#10 +
    '            raw = f.read(HEADER.size)'#10 +
    '            require(len(raw) == HEADER.size, ''truncated header'')'#10 +
    '            magic, version, endian, count, reserved, directory = HEADER.unpack(raw)'#10 +
    '            require((magic, version, endian, reserved, directory) =='#10 +
    '                    (b''O3DTBIN1'', 1, 0x01020304, 0, 32), ''unsupported header/version'')'#10 +
    '            size = self.path.stat().st_size'#10 +
    '            require(7 <= count <= 65536 and 32 + count * 40 <= size, ''invalid directory'')'#10 +
    '            previous = 32 + count * 40'#10 +
    '            total = 0'#10 +
    '            seen = set()'#10 +
    '            for i in range(count):'#10 +
    '                kind, flags, offset, packed, unpacked, crc, reserved = ENTRY.unpack(f.read(40))'#10 +
    '                kind = kind.decode(''ascii'')'#10 +
