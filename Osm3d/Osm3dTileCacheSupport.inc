    '        return [limited(v, 0) for v in value]'#10 +
    '    return value'#10 +
    ''#10 +
    ''#10 +
    'def main():'#10 +
    '    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)'#10 +
    '    sub = parser.add_subparsers(dest=''command'', required=True)'#10 +
    '    for name in (''info'', ''verify'', ''dump'', ''extract''):'#10 +
    '        item = sub.add_parser(name)'#10 +
    '        item.add_argument(''tile'', type=Path)'#10 +
    '        if name == ''dump'':'#10 +
    '            item.add_argument(''--layer'', choices=sorted(REQUIRED | {''MESH'', ''FACA'', ''BCOL'', ''RWID''}))'#10 +
    '            item.add_argument(''--index'', type=int, help=''directory index of one chunk'')'#10 +
    '            item.add_argument(''--limit'', type=int, default=20, help=''items per array; 0 means all'')'#10 +
    '        if name == ''extract'':'#10 +
