    '        require(abs(geo[0]) <= 90 and abs(geo[1]) <= 180 and'#10 +
    '                (geo[2:] == (1e9, 1e9, -1e9, -1e9) or'#10 +
    '                 all(abs(x) <= (90 if i % 2 == 0 else 180) for i, x in enumerate(geo[2:]))),'#10 +
    '                ''geographic bounds out of range'')'#10 +
