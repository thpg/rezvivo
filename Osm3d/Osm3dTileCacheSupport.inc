    '                        4 <= unpacked <= MAX_CHUNK and 0 < packed <= MAX_CHUNK and'#10 +
    '                        offset + packed <= size, f''invalid chunk {i}'')'#10 +
    '                require(flags != 0 or packed == unpacked, ''invalid raw chunk size'')'#10 +
    '                require(kind == ''MESH'' or kind not in seen, f''duplicate layer {kind}'')'#10 +
    '                seen.add(kind)'#10 +
    '                total += unpacked'#10 +
    '                require(total <= 4 * 1024 ** 3, ''tile exceeds size limit'')'#10 +
    '                self.entries.append(dict(index=i, kind=kind, flags=flags, offset=offset,'#10 +
    '                                         packed_bytes=packed, raw_bytes=unpacked, crc32=crc))'#10 +
